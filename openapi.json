        "required": [
          "at",
          "cpuPercent",
          "memoryBytes",
          "players"
        ]
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "settings": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "description": "Changed settings; keys left out keep their value"
          }
        },
        "required": [
          "settings"
        ]
