  "info": {
    "title": "Harrier API",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "SetupStatusDto": {
        "type": "object",
        "properties": {
          "needsSetup": {
            "type": "boolean",
            "description": "True until the owner account was created via the setup link"
          }
        },
        "required": [
          "needsSetup"
        ]
      },
      "SetupDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token from the setup link in the identity service log"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "token",
          "name",
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member"
            ]
          },
          "discord": {
            "type": "string",
            "nullable": true,
            "description": "Display name of the linked Discord account"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "discord"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member"
            ]
          },
          "discord": {
            "type": "string",
            "nullable": true,
            "description": "Display name of the linked Discord account"
          },
          "permissions": {
            "type": "array",
            "description": "What this user may do (ADR 0007); the web hides the rest",
            "items": {
              "type": "string",
              "enum": [
                "viewServers",
                "startStopServers",
                "sendCommands",
                "manageServers",
                "manageMembers",
                "manageAdmins"
              ]
            }
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "discord",
          "permissions"
        ]
      },
      "InviteCheckDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "AcceptInviteDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token from the invitation link"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "token",
          "name",
          "email",
          "password"
        ]
      },
      "ProvidersDto": {
        "type": "object",
        "properties": {
          "discord": {
            "type": "boolean",
            "description": "Whether \"Log in with Discord\" is configured (ADR 0008)"
          }
        },
        "required": [
          "discord"
        ]
      },
      "UserEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "admin",
              "member"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "discord": {
            "type": "string",
            "nullable": true,
            "description": "Display name of the linked Discord account"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "createdAt",
          "discord"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "InviteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          },
          "createdBy": {
            "type": "string",
            "description": "Name of the person who created the invitation"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "createdBy",
          "createdAt",
          "expiresAt"
        ]
      },
      "CreateInviteDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "member"
            ]
          }
        },
        "required": [
          "role"
        ]
      },
      "InviteCreatedDto": {
        "type": "object",
        "properties": {
          "invite": {
            "$ref": "#/components/schemas/InviteDto"
          },
          "url": {
            "type": "string",
            "description": "Link to share. Shown only once."
          }
        },
        "required": [
          "invite",
          "url"
        ]
      },
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "example": {
              "servers": "up"
            }
          }
        },
        "required": [
          "status",
          "version",
          "services"
        ]
      },
      "MetaDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "contract": {
            "type": "string",
            "description": "Hash of the API shape (paths + components). The web app compares it with its generated client."
          }
        },
        "required": [
          "version",
          "contract"
        ]
      },
      "AgentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Node ID (from the agent token)"
          },
          "name": {
            "type": "string",
            "description": "Node name given at registration"
          },
          "hostname": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "agentVersion": {
            "type": "string"
          },
          "protocol": {
            "type": "number"
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
