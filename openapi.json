            "type": "string",
            "enum": [
              "installing",
              "starting",
              "running",
              "stopping",
              "stopped",
              "crashed"
            ]
          },
          "statusMessage": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "nodeId",
          "templateId",
          "settings",
          "hostPort",
          "status",
          "statusMessage",
          "createdAt"
        ]
      },
      "CreateServerDto": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Survival"
          },
          "templateId": {
            "type": "string",
