  "info": {
    "title": "Harrier API",
    "description": "",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "example": {
              "servers": "up"
            }
          }
        },
        "required": [
          "status",
          "version",
          "services"
        ]
      },
      "MetaDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "contract": {
            "type": "string",
            "description": "Hash of the API shape (paths + components). The web app compares it with its generated client."
          }
        },
        "required": [
          "version",
          "contract"
        ]
      },
      "AgentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Node ID (from the agent token)"
          },
          "name": {
            "type": "string",
            "description": "Node name given at registration"
          },
          "hostname": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "agentVersion": {
            "type": "string"
          },
          "protocol": {
            "type": "number"
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "hostname",
          "os",
          "arch",
          "agentVersion",
          "protocol",
          "connectedAt"
        ]
      },
      "ServerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "templateId": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "hostPort": {
            "type": "number",
            "description": "Port players connect to on the node"
          },
          "status": {
            "type": "string",
            "enum": [
              "installing",
              "starting",
              "running",
              "stopping",
              "stopped",
              "crashed"
            ]
          },
          "statusMessage": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "nodeId",
          "templateId",
          "settings",
          "hostPort",
          "status",
          "statusMessage",
          "createdAt"
        ]
      },
      "CreateServerDto": {
        "type": "object",
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "example": "Survival"
          },
          "templateId": {
            "type": "string",
            "example": "minecraft-java/paper"
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                }
              ]
            }
          }
        },
        "required": [
          "nodeId",
          "name",
          "templateId"
        ]
      },
      "CommandDto": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "example": "say Hello"
          }
        },
        "required": [
          "command"
        ]
      },
      "NamedDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "LocalizedTextDto": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string"
          },
          "de": {
            "type": "string"
          }
        },
        "required": [
          "en"
        ]
      },
      "VariantDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "$ref": "#/components/schemas/LocalizedTextDto"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "TemplateConfigFieldDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "$ref": "#/components/schemas/LocalizedTextDto"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer"
            ]
          },
          "default": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "pattern": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "label",
          "type",
          "default"
        ]
      },
      "TemplateDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "minecraft-java/paper"
          },
          "game": {
            "$ref": "#/components/schemas/NamedDto"
          },
          "variant": {
            "$ref": "#/components/schemas/VariantDto"
          },
          "config": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TemplateConfigFieldDto"
            }
          }
        },
        "required": [
          "id",
          "game",
          "variant",
          "config"
        ]
      },
      "NodeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "online": {
            "type": "boolean",
            "description": "Whether the agent is connected right now"
          }
        },
        "required": [
          "id",
          "name",
          "lastSeenAt",
          "online"
        ]
      }
    }
  }
}
