          },
          "cpuPercent": {
            "type": "number",
            "description": "Average CPU usage; 100 = one core"
          },
          "memoryBytes": {
            "type": "number",
            "description": "Peak memory usage"
          },
          "players": {
            "type": "number",
            "nullable": true,
            "description": "Peak players online; null for games without a player query"
          }
