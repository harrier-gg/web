{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "systemHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDto"
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/meta": {
      "get": {
        "operationId": "systemMeta",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaDto"
                }
              }
            }
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/agents": {
      "get": {
        "operationId": "agentsList",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AgentDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "agents"
        ]
      }
    }
  },
  "info": {
    "title": "Harrier API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "services": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "up",
                "down"
              ]
            },
            "example": {
              "servers": "up"
            }
          }
        },
        "required": [
          "status",
          "version",
          "services"
        ]
      },
      "MetaDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "0.1.0"
          },
          "contract": {
            "type": "string",
            "description": "Hash of the API shape (paths + components). The web app compares it with its generated client."
          }
        },
        "required": [
          "version",
          "contract"
        ]
      },
      "AgentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "agentVersion": {
            "type": "string"
          },
          "protocol": {
            "type": "number"
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "hostname",
          "os",
          "arch",
          "agentVersion",
          "protocol",
          "connectedAt"
        ]
      }
    }
  }
}
